# ─────────────────────────────────────────────
#  Gym-Bro — archivos que Git NO debe guardar
# ─────────────────────────────────────────────

# ---------- Java / Maven (backend) ----------
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.properties

# ---------- Node / React (frontend) ----------
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local

# ---------- Configuracion local con contrasenas ----------
# NUNCA subir contrasenas de base de datos ni claves JWT
application-local.properties
application-local.yml
application-secret.properties
.env
.env.local
.env.*.local

# ---------- VS Code ----------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# ---------- IntelliJ IDEA ----------
.idea/
*.iml
*.iws
*.ipr
out/

# ---------- Eclipse ----------
.classpath
.project
.settings/
bin/

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs y temporales ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.bak
*.swp

# ---------- Base de datos local ----------
*.db
*.sqlite
pgdata/